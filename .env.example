# Mistral API key (free "Experiment" tier: https://console.mistral.ai). Never commit the real one.
MISTRAL_API_KEY=your-mistral-api-key-here

# Primary model, and a second one used if the primary keeps failing.
# Bigger/more accurate alternative for the primary: mistral-large-latest (slower).
LLM_MODEL=open-mistral-nemo
LLM_FALLBACK_MODEL=mistral-small-latest

# Server
PORT=8000
LOG_LEVEL=info

# Optional tuning
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_TOTAL_BUDGET_SECONDS=22
# Minimum seconds between Mistral calls (free tier ~1 request/second). 0 turns it off.
MISTRAL_MIN_INTERVAL_SECONDS=1.1
